# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
swp.*
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 构建产物与安装包一律不入库，统一通过 GitHub Releases 分发
# （二进制进 git 会永久膨胀历史，且受单文件 100MB 限制）
/dist/

# 基线对照用的原始参考 APK 不入库（verify_reference 只读取已提取的文本基准，
# 需要重新提取时请自行向原作者获取原版 APK 放到此处）
/reference/*.apk
docs/maojuan_plan/node_modules/
docs/ui_review_assets/
.qoder/
/windows/flutter/ephemeral/

# 安全加固：密钥/证书永不入库
android/key.properties
**/*.jks
**/*.keystore

# 发布校验报告为本地生成物
tools/reference_check/reference_check_report.txt

# 推广页的安装包副本与部署暂存目录（由 tools/deploy_promo.ps1 生成）
promo/download/
/build/promo_deploy/

# 参赛材料与内部草稿：不入公开仓库（已从历史中清除，勿再提交）
# 原件保存在仓库外的私有目录（见 docs/上线操作手册.md）
docs/*计数草稿*.txt
docs/*项目计划书*.docx
docs/maojuan_plan/
tools/planbook_gen/

# 开发期截图：不入库（用户要求仓库只保留源码；成品图只放 README 引用的那几张）
docs/ui_new/
